cells:
  - kind: 1
    value: "# Rules of Precendence\r

      - expressions in the WHERE clause are performed in the following order\r

      \r

      | Order | Meaning                       |\r

      | ----- | ----------------------------- |\r

      | 1     | arithmetic operator           |\r

      | 2     | concatenation operator        |\r

      | 3     | comparison operator           |\r

      | 4     | IS [NOT] NULL, LIKE, [NOT] IN |\r

      | 5     | [NOT] BETWEEN                 |\r

      | 6     | not equal to                  |\r

      | 7     | NOT logical operator          |\r

      | 8     | AND logical operator          |\r

      | 9     | OR logical operator           |\r

      \r

      - use parentheses to avoid logical order confusion or change the order
      specifically"
    languageId: markdown
  - kind: 2
    value: "-- returns employees who are: any IT Programmer (IT_PROG), regardless \r

      -- of salary, stock clerks (ST_CLERK) only if their salary is greater \r

      -- than $5,000\r

      select first_name, last_name, job_id salary\r

      from EMPLOYEES\r

      where job_id = 'IT_PROG'\r

      or job_id = 'ST_CLERK'\r

      and salary > 5000;"
    languageId: oracle-sql
  - kind: 2
    value: "-- list employees who job_id is equal to IT_PROG OR ST_CLERK and
      compare\r

      -- the returning rows with the \"salary is greater than 5000\" condition\r

      select first_name, last_name, job_id salary\r

      from EMPLOYEES\r

      where (job_id = 'IT_PROG' or job_id = 'ST_CLERK') and salary > 5000;"
    languageId: oracle-sql
  - kind: 2
    value: "-- Retrieve all IT Programmers regardless of salary, and Stock Clerks \r

      -- with salaries greater than $5,000.\r

      select first_name, last_name, job_id salary\r

      from EMPLOYEES\r

      where job_id = 'IT_PROG' or (job_id = 'ST_CLERK' and salary > 5000);"
    languageId: oracle-sql
  - kind: 2
    value: "-- The query returns employees in Department 20 only if their salary is
      \r

      -- greater than $10,000, all employees in Department 30, regardless of \r

      -- their salary.\r

      select first_name, last_name, department_id, salary\r

      from EMPLOYEES\r

      where salary > 10000 and department_id = 20 or department_id= 30;"
    languageId: oracle-sql
  - kind: 2
    value: "-- Display employees earning more than $10,000 who work in \r

      -- Department 20 or Department 30.\r

      select first_name, last_name, department_id, salary\r

      from EMPLOYEES\r

      where salary > 10000 and (department_id = 20 or department_id= 30);"
    languageId: oracle-sql
