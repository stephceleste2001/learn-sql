cells:
  - kind: 1
    value: "# Logical Operators\r

      - enable us to use more than one condition in the WHERE clause\r

      \r

      | Operator |
      Meaning                                                       |\r

      | -------- | -------------------------------------------------------------
      |\r

      | AND      | Returns TRUE if all component conditions are
      true             |\r

      | OR       | Returns TRUE if at least one of component conditions are true
      |\r

      | NOT      | Returns TRUE if the condition is false |\r

      \r

      ## AND Operator\r

      - means all conditions must be true \r

      \r

      | AND   | TRUE  | FALSE | NULL  |\r

      | ----- | ----- | ----- | ----- |\r

      | TRUE  | TRUE  | FALSE | NULL  |\r

      | FALSE | FALSE | FALSE | FALSE |\r

      | NULL  | NULL  | FALSE | NULL |\r

      \r

      ## OR Operator\r

      - means one or more conditions must be true\r

      \r

      | OR    | TRUE | FALSE | NULL |\r

      | ----- | ---- | ----- | ---- |\r

      | TRUE  | TRUE | TRUE  | TRUE |\r

      | FALSE | TRUE | FALSE | NULL |\r

      | NULL  | TRUE | NULL  | NULL |\r

      \r

      ## NOT Operator\r

      - is used to negate a condition\r

      \r

      | NOT | TRUE  | FALSE | NULL |\r

      | --- | ----- | ----- | ---- |\r

      |     | FALSE | TRUE  | NULL |"
    languageId: markdown
  - kind: 2
    value: "-- list employees whose has job_id is sales representative and whose\r

      -- salary is greater than 10,000\r

      select * from employees where job_id = 'SA_REP'\r

      \                              AND salary > 10000;"
    languageId: oracle-sql
  - kind: 2
    value: "-- list employees whose has job_id is sales representative, salary is \r

      -- greater than 10,000, and whose first_name is Lisa\r

      select * from employees where job_id = 'SA_REP'\r

      \                              AND salary > 10000\r

      \                              AND first_name = 'Lisa';"
    languageId: oracle-sql
  - kind: 2
    value: "-- list employees whose job_id is sales reprenstative or salary is\r

      -- greater than 10,000\r

      select * from employees where job_id = 'SA_REP'\r

      \                              OR salary > 10000;"
    languageId: oracle-sql
  - kind: 2
    value: "-- list employees' first name, last name, job ID, and salary of \r

      -- all employees who are IT Programmers and earn $5,000 or more\r

      select first_name, last_name, job_id, SALARY\r

      from employees \r

      where job_id = 'IT_PROG' AND SALARY >= 5000;\r\n"
    languageId: oracle-sql
  - kind: 2
    value: "-- list employees' first name, last name, job ID, and salary of
      employees \r

      -- who satisfy either of these conditions: job_id is IT_PROG OR salary \r

      -- is $5,000 or more.\r

      select first_name, last_name, job_id salary\r

      from EMPLOYEES\r

      where job_id = 'IT_PROG' OR salary >= 5000;"
    languageId: oracle-sql
  - kind: 2
    value: "-- list employees' last name, job ID, and salary of employees who \r

      -- earn more than $10,000, but exclude anyone who is a Sales Manager, \r

      -- Stock Clerk, or Shipping Clerk\r

      select last_name, job_id, salary\r

      from employees\r

      where salary > 10000\r

      and job_id not in ('SA_MAN', 'ST_CLERK', 'SH_CLERK');"
    languageId: oracle-sql
  - kind: 2
    value: "-- who earn more than $10,000 and whose job is either Sales Manager \r

      -- (SA_MAN) or Sales Representative (SA_REP)\r

      select * from employees where salary > 10000 and job_id in ('SA_MAN',
      'SA_REP');"
    languageId: oracle-sql
  - kind: 2
    value: "-- list employees who earn more than $10,000, but exclude anyone \r

      -- whose job is Sales Manager (SA_MAN) or Sales Representative \r

      -- (SA_REP) \r

      select * from employees where salary > 10000 and job_id not in ('SA_MAN',
      'SA_REP');"
    languageId: oracle-sql
